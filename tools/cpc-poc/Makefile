# RAGE1 CPC R3 PoC build.
#
# Extends R2 with PNG-derived sprite data:
#   assets/test.png -> cpc_asset_convert.pl -> assets/test.c/test.h
#   -> linked here alongside the R2 text output.
#
# cpctelera itself is NEVER compiled here — see cpc-renderer.md §4.2 / §6.

NAME         = poc
CC           = zcc
TARGET       = +cpc
# NOTE: -zorg=0x4000 is a PoC-specific workaround for the firmware-font
# lower-ROM page-in (see R2 / caprice-testing skill).  The real engine
# renders from its own charset and won't need this relocation.
# -Iassets: lets <types.h> in the generated test.h resolve to assets/types.h
# (cpctelera compat shim — see assets/types.h).
CFLAGS       = -compiler=sdcc -zorg=0x4000 -SO2 --max-allocs-per-node200000 -Iassets
ENGINE_CPC   = ../../engine/src/cpc
ASMSRC       = $(ENGINE_CPC)/cpct_video.asm $(ENGINE_CPC)/cpct_strings_m1.asm
TOOLS_DIR    = ..

# R3: PNG-derived sprite source (generated by cpc_asset_convert.pl)
ASSET_PNG    = assets/test.png
ASSET_C      = assets/test.c
ASSET_H      = assets/test.h
CSRC         = main.c $(ASSET_C)

.PHONY: all clean assets

all: $(NAME).dsk

# Generate CPC sprite data from PNG (run cpc_asset_convert.pl)
assets: $(ASSET_C)

$(ASSET_C) $(ASSET_H): $(ASSET_PNG)
	perl $(TOOLS_DIR)/cpc_asset_convert.pl \
	    --mode spritesheet \
	    --cpc-mode 1 \
	    --tile-w 16 \
	    --tile-h 16 \
	    --basename g_r3sprite \
	    --output assets/test \
	    $(ASSET_PNG)

# .dsk (Caprice32-loadable)
# Note: assets/test.c includes "test.h" — sdcc resolves this relative to the
# source file's directory (assets/), so test.h is found without extra -I flags.
$(NAME).dsk: $(CSRC) $(ASMSRC) $(ASSET_H)
	$(CC) $(TARGET) $(CFLAGS) -create-app -subtype=dsk -o $(NAME) \
	    $(CSRC) $(ASMSRC)
	$(CC) $(TARGET) $(CFLAGS) -create-app -subtype=none -o $(NAME)_tape \
	    $(CSRC) $(ASMSRC) 2>/dev/null || true

clean:
	rm -f $(NAME) $(NAME).* $(NAME)_tape* *.o $(ENGINE_CPC)/*.o $(ASSET_C) $(ASSET_H)

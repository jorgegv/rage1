// Phase A5-3: full-color CPC BTile from a PNG.
// This exercises the cpc_asset_convert.pl path in datagen.pl, including the
// crop fix (A5 review #2): the converter receives ONLY the 8x8 region at
// (8,8) — a black/white pattern — not the whole 160x32 sheet.
// 1x1 tile (8x8 pixels) cropped from the shared btile test PNG.
// On CPC: cpct_img2tileset converts the cropped region to mode-1 pixel bytes
// and emits build/generated/cpc/btile.c + btile.h.
// On ZX: would use RAGE::PNGFileUtils (not used in this test, CPC-only).
BEGIN_BTILE
	NAME	PngBtile
	ROWS	1
	COLS	1

	PNG_DATA	FILE=game_data/png/btile.png XPOS=8 YPOS=8 WIDTH=8 HEIGHT=8

	ATTR	INK_WHITE | PAPER_BLACK
END_BTILE

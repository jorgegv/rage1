// minimal_cpc — clone of games/minimal_jsp built for the Amstrad CPC with the
// JSP graphics backend (Task 5 / R9, README §5.13).  Same assets as minimal_jsp
// (8-frame animated hero, Live btile, Bullet) — converted to CPC mode-1 by
// datagen's CPC asset backend (RAGE::AssetBackend::CPCMode1).  GFX_BACKEND=jsp
// gives pixel-smooth (1 px) movement; PLATFORM cpc464 = cpc-flat.
//
// The ZX beeper SOUND lines from minimal_jsp are dropped: cpc-flat has no
// beeper backend (CPC audio is the AT2 AKG player, exercised by
// minimal_audio_cpc, not here).  The MENU game-function uses the cpc-flat
// keyboard-select menu (game_src/menu.c, Phase IN6).
BEGIN_GAME_CONFIG
	NAME		MinimalCpc
	PLATFORM	cpc464
	GFX_BACKEND	JSP
	SCREEN		INITIAL=Screen01
	DEFAULT_BG_ATTR	INK_CYAN | PAPER_BLACK
	GAME_FUNCTION	TYPE=MENU NAME=my_menu_screen FILE=menu.c
	GAME_AREA	TOP=1 LEFT=1 BOTTOM=21 RIGHT=30
	LIVES_AREA	TOP=23 LEFT=1 BOTTOM=23 RIGHT=10
	INVENTORY_AREA	TOP=23 LEFT=21 BOTTOM=23 RIGHT=30
	DEBUG_AREA	TOP=0 LEFT=1 BOTTOM=0 RIGHT=15
END_GAME_CONFIG

// Hero definition.  No BULLET (no weapon) to keep the CPC engine link set
// minimal.  HSTEP/VSTEP/SEQUENCE_* are required by datagen even though the
// hero stays put on CPC (real input is Phase IN6 — the stubbed input HAL
// reports no movement).  LIVES reuses the Live BTile.
BEGIN_HERO
	NAME		Hero
	SPRITE		Hero
	SEQUENCE_UP	WalkUp
	SEQUENCE_DOWN	WalkDown
	SEQUENCE_LEFT	WalkLeft
	SEQUENCE_RIGHT	WalkRight
	ANIMATION_DELAY	3
	HSTEP		2
	VSTEP		2
	LIVES		NUM_LIVES=3 BTILE=Live
END_HERO

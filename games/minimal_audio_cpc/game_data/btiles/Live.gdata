// A single 8x8 BTile used as on-screen decoration.  MONO game => the ATTR is
// inert on CPC (the JSP gfx backend (void)-discards it); the pixel layer is
// what renders, mapped to mode-1 by the CPC asset backend.
BEGIN_BTILE
	NAME	Live
	ROWS	1
	COLS	1

	PIXELS	..####..####....
	PIXELS	##############..
	PIXELS	##############..
	PIXELS	##############..
	PIXELS	..##########....
	PIXELS	....######......
	PIXELS	......##........
	PIXELS	................

	ATTR	INK_RED | PAPER_BLACK | BRIGHT
END_BTILE

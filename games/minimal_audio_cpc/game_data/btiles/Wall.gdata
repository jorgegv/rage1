// A 1x1 solid-ish wall BTile, used to draw a border of "one screen of BTiles"
// so the engine map-draw path is exercised on CPC.  ATTR inert on CPC (mono).
BEGIN_BTILE
	NAME	Wall
	ROWS	1
	COLS	1

	PIXELS	################
	PIXELS	#..........#..#.
	PIXELS	#..........#..#.
	PIXELS	################
	PIXELS	#..#..........#.
	PIXELS	#..#..........#.
	PIXELS	################
	PIXELS	................

	ATTR	INK_WHITE | PAPER_BLACK
END_BTILE

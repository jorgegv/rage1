################################################################################
##
## Makefile-cpc-banked — CPC 6128 banked build
##
## Phase T3a bring-up: this file is currently a copy of Makefile-cpc-flat — it
## builds a NO-BANKING CPC programme (the cpc-hello-banked smoke game) through
## the +cpc toolchain to a bootable .dsk, proving the cpc6128 plumbing. The
## banking machinery (bank-switch primitive, datasets, codesets, banks, the
## bank-aware asmloader — modelled on Makefile-zx128) lands in Phase B6/B7; see
## doc/multiplatform-plan/management/cpc-banked-bringup.md.
##
## Key differences from the ZX builds:
##   - ZCC_TARGET=+cpc  (not +zx)
##   - No ZX BASIC loader (AMSDOS header embedded by zcc -create-app)
##   - No TAP packaging: produces .cpc, .dsk, .cdt instead
##   - Section check uses mmap-cpc-banked.inc
##
## IMPORTANT — the bootable .dsk is built with the single-step
## `zcc -create-app -subtype=dsk` path, NOT a separate `appmake +cpc --disk`
## call. `appmake +cpc --disk` emits a malformed ~2.7 KB stub that Caprice32
## reports as "disc missing"; only the integrated `zcc -create-app` driver
## produces a valid ~194 KB Extended-CPC-DSK that boots. The raw .cpc AMSDOS
## single-file image (~2.7 KB: AMSDOS header + payload — small by design) is
## produced with `appmake +cpc -b <linked-bin>` (no --disk).
##
## Phase T3a: this file builds a NO-BANKING CPC programme (the
## games/cpc-hello-banked smoke game) to prove the cpc6128 plumbing; the
## RAGE1 engine is NOT linked yet, and the banking machinery (bank-switch
## primitive, datasets, codesets, banks) lands in Phase B6/B7.
##
################################################################################

.SILENT:

MYMAKE			= $(MAKE) -s -f Makefile-cpc-banked
ZPRAGMA_INC		= zpragma-cpc-banked.inc

# T2-1: CPC z88dk target
ZCC_TARGET		= +cpc

# ---- Shape A memory map, sourced from etc/rage1-config.yml via yq -----------
# Single source of truth for the cpc-banked resident map
# (doc/multiplatform-plan/management/cpc-banked-bringup.md lines 56-66).  These
# vars are injected below as C (-D) / asm (-Ca-D) #defines that the consumers
# (JSP jsp_data.c, the linker mmap) read.  MUST be set BEFORE `-include
# Makefile.common` so JSP_CPC_CFLAGS picks up JSP_REGISTER_SP.
RAGE1_CONFIG_YML	= etc/rage1-config.yml
MM_CRT_ORG_CODE		:= $(shell yq '.memory_map.cpc_banked.crt_org_code'               $(RAGE1_CONFIG_YML))
MM_REGISTER_SP		:= $(shell yq '.memory_map.cpc_banked.register_sp'                $(RAGE1_CONFIG_YML))
MM_PAGE_C_DATA_BASE	:= $(shell yq '.memory_map.cpc_banked.page_c_data_base'           $(RAGE1_CONFIG_YML))
MM_BANKED_DATASET_BASE	:= $(shell yq '.memory_map.cpc_banked.banked_dataset_base'        $(RAGE1_CONFIG_YML))
MM_DATASET_LOAD_BASE	:= $(shell yq '.memory_map.cpc_banked.dataset_load_base'          $(RAGE1_CONFIG_YML))
MM_CODESET_ASSETS_BASE	:= $(shell yq '.memory_map.cpc_banked.codeset_assets_base'        $(RAGE1_CONFIG_YML))
MM_BANKED_FUNC_TBL_BASE	:= $(shell yq '.memory_map.cpc_banked.banked_function_table_base' $(RAGE1_CONFIG_YML))
MM_JSP_BAT		:= $(shell yq '.memory_map.cpc_banked.jsp_data.bat'               $(RAGE1_CONFIG_YML))
MM_JSP_FTT		:= $(shell yq '.memory_map.cpc_banked.jsp_data.ftt'               $(RAGE1_CONFIG_YML))
MM_JSP_DTT		:= $(shell yq '.memory_map.cpc_banked.jsp_data.dtt'               $(RAGE1_CONFIG_YML))
MM_JSP_BTT		:= $(shell yq '.memory_map.cpc_banked.jsp_data.btt'               $(RAGE1_CONFIG_YML))
MM_JSP_ROTTBL		:= $(shell yq '.memory_map.cpc_banked.jsp_data.rottbl'            $(RAGE1_CONFIG_YML))

# Override the JSP stack (Makefile.common's JSP_CPC_CFLAGS default is 0x9800 for
# cpc-flat); cpc-banked's JSP block moved to page B so the stack lives in page C.
JSP_REGISTER_SP		:= $(MM_REGISTER_SP)

# JSP data-block addresses -> jsp_data.c (C arrays, __at). The #ifndef guards in
# jsp_data.c let these -D values win over the cpc-flat 0x9800 defaults.
# page_c_data_base -> the mmap (asm), to org rodata/data/bss into page C.
# banked_dataset_base -> dataset.h BANKED_DATASET_BASE_ADDRESS (#ifndef-guarded),
# the dataset decompress-buffer base; SAME key datagen reads via -B (Makefile).
# dataset_load_base / codeset_assets_base / banked_function_table_base ->
# memory.h + codeset.h (all #ifndef-guarded); the swap-window bases banked assets
# are read/run from.  codeset_assets_base is also the SAME key datagen reads via -C.
CPC_MM_DEFINES		= -DBAT_ADDR=$(MM_JSP_BAT) -DFTT_ADDR=$(MM_JSP_FTT) \
			  -DDTT_ADDR=$(MM_JSP_DTT) -DBTT_ADDR=$(MM_JSP_BTT) \
			  -DROTTBL_ADDR=$(MM_JSP_ROTTBL) \
			  -DBANKED_DATASET_BASE_ADDRESS=$(MM_BANKED_DATASET_BASE) \
			  -DDATASET_LOAD_BASE=$(MM_DATASET_LOAD_BASE) \
			  -DCODESET_ASSETS_BASE=$(MM_CODESET_ASSETS_BASE) \
			  -DBANKED_FUNCTION_TABLE_BASE=$(MM_BANKED_FUNC_TBL_BASE) \
			  -Ca-DCPC_BANKED_PAGE_C_DATA_BASE=$(MM_PAGE_C_DATA_BASE) \
			  -pragma-define:CRT_ORG_CODE=$(MM_CRT_ORG_CODE)

# T3a: no-banking image, no TAP/bank list (banking machinery is Phase B6/B7).
CPC_NAME		= game
CPC_FILE		= $(CPC_NAME).cpc
DSK_FILE		= $(CPC_NAME).dsk
CDT_FILE		= $(CPC_NAME).cdt

-include Makefile.common

# ---- Override Makefile.common vars not used at Phase T3a (no banking yet) ----
# Banking, datasets, codesets and SUBs arrive in Phase B6/B7.
BANK_BINS		=
BANK_TAPS		=
SUB_DIRS		=
SUB_BINS		=
SUB_TAPS		=

# ---- B6 step 7: banked-code source dir for this platform ------------------
# This build's banked-code sources live in engine/banked_code/cpc-banked/ (the
# CPC-6128 counterpart of the ZX engine/banked_code/128/ split; see DC3-A and
# that dir's README).  BANKED_CODE_{DIR,SRC,OBJS}_CPC_BANKED are defined in
# Makefile.common; selected here as the active banked-code set so the Stage-B7
# banked-code compile/link target can consume it platform-agnostically.  At B6
# the dir holds no compiled sources yet (only the README placeholder), so the
# wildcards are empty and this binding is inert until B7.
BANKED_CODE_DIR_PLATFORM	= $(BANKED_CODE_DIR_CPC_BANKED)
BANKED_CODE_SRC_PLATFORM	= $(BANKED_CODE_SRC_CPC_BANKED)
BANKED_CODE_OBJS_PLATFORM	= $(BANKED_CODE_OBJS_CPC_BANKED)

# T3a base source set: game_src + build/generated only.  (For cpc-hello-banked
# the RAGE1 engine is NOT linked.)  Override CSRC/ASMSRC/OBJS accordingly.
CSRC			= $(wildcard $(GAME_SRC_DIR)/*.c) $(wildcard $(GENERATED_DIR)/*.c)
ASMSRC			= $(wildcard $(GAME_SRC_DIR)/*.asm) $(wildcard $(GENERATED_DIR)/*.asm)

# ---- B6-1/B6-2: bank-switch primitive validation link set -----------------
# A game that opts in (CPC_LINK_BSWITCH=1, set by `make build-cpc-bswitch-test`)
# links ONLY the bank-switch primitive engine/src/00bswitch.c on top of its own
# game_src.  This is the minimal link that exercises the real cpc-banked
# memory_switch_bank() (the games/cpc-bswitch-test probe) without pulling the
# rest of the engine.  The game supplies interrupt_nesting_level itself.
ifeq ($(CPC_LINK_BSWITCH),1)
CSRC			+= $(ENGINE_DIR)/src/00bswitch.c
endif

# ---- B6-8: CPC IM1 ISR validation link set --------------------------------
# A game that opts in (CPC_LINK_ISR=1, set by `make build-cpc-isr-test`) links
# the CPC interrupt path engine/src/interrupts.c plus the swap-active globals
# (current_time / periodic_tasks_enabled / interrupt_nesting_level / the asset
# pointers / memory_current_memory_bank) on top of its own game_src.  Minimal
# link that exercises init_interrupts() + the 300->50 Hz fast ISR on cpc-banked
# (the games/cpc-isr-test probe) without pulling the rest of the engine.
# B7 step 9.4: those globals now come from the cpc-banked LOWMEM asm file
# (engine/src/cpc-banked/asmdata_cpc_banked.asm); engine/src/cpc/asmdata_cpc.c
# is an empty TU on cpc-banked (it is the cpc-FLAT definition).
ifeq ($(CPC_LINK_ISR),1)
CSRC			+= $(ENGINE_DIR)/src/interrupts.c
ASMSRC			+= $(wildcard $(ENGINE_DIR)/src/cpc-banked/*.asm)
endif

# ---- Phase R4: real CPC gfx HAL link set -------------------------------
# A CPC game that opts in (CPC_LINK_ENGINE_GFX=1, set by `make build-minimal_cpc`)
# links the REAL RAGE1 gfx HAL: the generic gfx.c/screen.c, the active CPC
# backend gfx_jsp.c (gfx_sp1.c compiles to an EMPTY TU under jsp), and the
# translated CPC HW-I/O asm primitives under engine/src/cpc/.  This is the
# minimal engine subset needed to RENDER statically (R4); the full engine
# main loop / datasets / banking stay OUT (deferred to G8/B6).  The game then
# supplies its OWN main() in game_src (so engine/src/main.c is NOT pulled).
CPC_ENGINE_GFX_CSRC	= $(ENGINE_DIR)/src/gfx.c \
			  $(ENGINE_DIR)/src/gfx_sp1.c \
			  $(ENGINE_DIR)/src/gfx_jsp.c \
			  $(ENGINE_DIR)/src/screen.c
# rage1_cpc_isr_flat.asm is the cpc-FLAT placement wrapper for the shared IM1
# handler (engine/src/cpc/rage1_cpc_isr_body.inc); cpc-banked supplies its own
# placement wrapper (engine/src/cpc-banked/rage1_cpc_isr.asm, code_crt_common
# <0x4000), so filter the flat one OUT to avoid a duplicate _rage1_cpc_isr.
# (Same filter-out pattern as 00asmdata.asm above.)
CPC_ENGINE_GFX_ASMSRC	= $(filter-out %/rage1_cpc_isr_flat.asm, \
			    $(wildcard $(ENGINE_DIR)/src/cpc/*.asm))
# Pre-baked CPC asset sources live in a game_src/assets/ subdir (not matched by
# the top-level $(GAME_SRC_DIR)/*.c wildcard) — pull them in explicitly.
CPC_ASSET_CSRC		= $(wildcard $(GAME_SRC_DIR)/assets/*.c)

ifeq ($(CPC_LINK_ENGINE_GFX),1)
CSRC			+= $(CPC_ENGINE_GFX_CSRC) $(CPC_ASSET_CSRC)
ASMSRC			+= $(CPC_ENGINE_GFX_ASMSRC)
# -I game_src so a game's own "assets/sprite.h" resolves; -I the assets dir for
# any game-supplied pre-baked asset headers.
CPC_EXTRA_INC		= -I$(GAME_SRC_DIR) -I$(GAME_SRC_DIR)/assets
endif

# ---- Phase G8: full RAGE1 ENGINE LOOP link set (cpc-flat) --------------
# A CPC game that opts in (CPC_LINK_ENGINE_FULL=1, set by `make build-minimal_cpc`)
# links the WHOLE RAGE1 engine so the interrupt-driven game loop runs on real
# CPC hardware (gfx.md Phase G8).  This is the cpc-flat analogue of the zx48
# link set (Makefile-zx48 adds BANKED_CODE_SRC_COMMON to a flat, no-banking
# build): engine/src/*.{c,asm} + the platform-neutral banked_code/common game
# loop sources + generated + game_src.  The game supplies NO main() — the
# engine's engine/src/main.c entry is pulled.
#
# One banked_code/common source is ZX-only and EXCLUDED on cpc-flat:
#   - audio_zx_beeper.c : ZX beeper (bit_beepfx); the CPC has no beeper backend.
#       The engine's audio_sfx_beeper_*() calls resolve to AU4's inline CPC
#       shims in rage1/audio_cpc_ay.h, so no .c body is needed.
# bullet.c (weapon/bullet logic) IS included: it is fully guarded by
# #ifdef BUILD_FEATURE_HERO_HAS_WEAPON, so it compiles to an empty TU for
# no-weapon games (minimal_audio_cpc) and provides bullet_add /
# bullet_animate_and_move_all for games with a weapon (minimal_cpc clone of
# minimal_jsp — R9).
# (cpc6128 / cpc-banked relocates these into real banks — Phase T3/B6.)
# engine/src/*.c, MINUS nothing (the ZX-only bodies self-#ifdef out under +cpc).
# engine/src/*.asm MINUS 00asmdata.asm: that file hand-places the timekeeping /
# asset / interrupt globals in the ZX-only `code_crt_common` low-memory section,
# which the +cpc CRT does not map (the linker would silently drop it at $0000,
# colliding with the CPC restart + 0x0038 IM1 vectors).  On cpc-flat those
# globals have no low-memory constraint and are defined as plain C BSS in
# engine/src/cpc/asmdata_cpc.c instead (pulled in via engine/src/cpc/*.c below).
CPC_ENGINE_FULL_CSRC	= $(wildcard $(ENGINE_DIR)/src/*.c) \
			  $(wildcard $(ENGINE_DIR)/src/cpc/*.c)
# B7 step 9.4: engine/src/*.asm MINUS 00asmdata.asm (its code_crt_common
# globals are re-homed below 0x4000 by asmdata_cpc_banked.asm, added below),
# PLUS the cpc-banked-only low-section file engine/src/cpc-banked/*.asm that
# hand-places the 7 swap-active globals in page A.  That file lives OUTSIDE the
# engine/src/cpc/*.asm wildcard (which Makefile-cpc-flat also globs), so it
# never leaks into the cpc-flat build.
CPC_ENGINE_FULL_ASMSRC	= $(filter-out %/00asmdata.asm, \
			    $(wildcard $(ENGINE_DIR)/src/*.asm)) \
			  $(wildcard $(ENGINE_DIR)/src/cpc-banked/*.asm)
CPC_BANKED_COMMON_CSRC	= $(filter-out %/audio_zx_beeper.c, \
			    $(wildcard $(BANKED_CODE_DIR_COMMON)/*.c))
CPC_BANKED_COMMON_ASMSRC = $(wildcard $(BANKED_CODE_DIR_COMMON)/*.asm)

ifeq ($(CPC_LINK_ENGINE_FULL),1)
# CSRC/ASMSRC are REASSIGNED (=) here, which drops the JSP library sources that
# Makefile.common added to CSRC/ASMSRC for GFX_BACKEND=jsp — so pull them back
# in via $(JSP_CSRC)/$(JSP_ASMSRC) (empty unless the backend is jsp). With the
# jsp backend the active gfx body is gfx_jsp.c (gfx_sp1.c compiles to an empty
# TU); the engine/src/cpc/*.asm HW-I/O primitives (mode/palette/keyboard) are
# still linked via $(CPC_ENGINE_GFX_ASMSRC). README §5.13 / cpc-renderer R6.
CSRC			= $(CPC_ENGINE_FULL_CSRC) $(CPC_BANKED_COMMON_CSRC) $(JSP_CSRC) \
			  $(wildcard $(GAME_SRC_DIR)/*.c) $(wildcard $(GENERATED_DIR)/*.c)
ASMSRC			= $(CPC_ENGINE_FULL_ASMSRC) $(CPC_BANKED_COMMON_ASMSRC) \
			  $(CPC_ENGINE_GFX_ASMSRC) $(JSP_ASMSRC) \
			  $(wildcard $(GAME_SRC_DIR)/*.asm) $(wildcard $(GENERATED_DIR)/*.asm)
CPC_EXTRA_INC		= -I$(GAME_SRC_DIR)
endif

OBJS			= $(CSRC:.c=.o) $(ASMSRC:.asm=.o)

# Override CFLAGS: +cpc uses the default clib (NOT -clib=sdcc_iy, which is
# ZX-specific). -SO2 instead of -SO3 for CPC (R2 PoC value). The pragma
# include points to zpragma-cpc-banked.inc (CRT_ORG_CODE/stack/EIDI). At
# Phase T3a it deliberately does NOT set __MMAP=-1 — see the long note in
# zpragma-cpc-banked.inc (the +cpc CRT pre-defines __MMAP=0 and rejects the
# override). The +cpc CRT's built-in section layout is used.
# $(JSP_CPC_CFLAGS) (from Makefile.common) carries the JSP CPC build flags
# (JSP_TARGET_CPC + CPC_MODE1 + JSP_CELL_MODEL_PIXEL to C and asm, the asm
# include root, and REGISTER_SP); empty unless GFX_BACKEND=jsp on +cpc.
CFLAGS			= -vn -SO2 --opt-code-size -compiler=sdcc --max-allocs-per-node200000 -pragma-include $(ZPRAGMA_INC) $(INC) $(CPC_EXTRA_INC) $(JSP_CPC_CFLAGS) $(CPC_MM_DEFINES) $(DEBUG_FLAGS)

# B7 step 9.5: this platform's link-time memory map source (zpragma sets
# MMAP=-1).  Staged to the transient ./mmap.inc by the shared $(STAGE_MMAP) in
# Makefile.common right before each +cpc link.  Previously this build overwrote
# the tracked ZX mmap.inc with a backup/restore trap; that trap was bypassed by
# SIGKILL (an interrupted build left the ZX map corrupted).  Now mmap.inc is a
# gitignored per-build artifact and the ZX/CPC source maps are fully separate.
MMAP_SRC		= mmap-cpc-banked.inc

# B7 step 9.5 ("Option 1"): custom minimal crt0 for the resident GAME.BIN image.
# The stock +cpc CRT prologue runs firmware-dependent startup (kl_rom_walk /
# AMSDOS drive restore / loadbanks) BEFORE its own exx-seize; GAME.BIN is jp'd
# into from LOADER.BIN (already in process-exx state, ROMs off), so those calls
# crash before main().  This crt0 drops that prologue (see its header).  Passed
# to the GAME.BIN link via -crt0=; only the GAME.BIN link uses it (datasets /
# codesets are --no-crt).
# Absolute path: zcc relocates the crt0 into its own temp build dir, so a cwd-
# relative path is unreliable (see zcc.c "-crt0" note); $(CURDIR) is the build
# root for both the normal build and the per-game split-test snapshot.
CPC_CRT0		= $(CURDIR)/crt0-cpc-banked.asm

# B7 step 10: custom crt0 for the cold-boot LOADER.BIN.  It is the stock +cpc
# crt0 MINUS the `call cpc_enable_process_exx_set`, so the loader keeps the
# firmware exx/ISR state PRISTINE and can do sequential AMSDOS CAS disc loads
# (with DIRECT $bcxx calls) without the 2nd-transaction crash that the
# process-exx seize causes (bisected 2026-06-11; see the crt0's header).  Passed
# to the loader link via -crt0=; absolute path for the same reason as CPC_CRT0.
CPC_LOADER_CRT0		= $(CURDIR)/crt0-cpc-banked-loader.asm

# B7 step 9.5: STAGE_MMAP (cp $(MMAP_SRC) -> ./mmap.inc) is shared in
# Makefile.common; this build invokes it before each +cpc link via `$(STAGE_MMAP); \`.

# ---- Phase G7: engine compile-test path --------------------------------
# G7-4: type-check the WHOLE RAGE1 engine (engine/src/*.c) under +cpc against
# the live JSP gfx backend.  This is COMPILE-ONLY — we drive each .c to a
# .o (via Makefile.common's generic `%.o: %.c` rule) and deliberately do NOT
# link.  Linkage may fail at G7 and that is explicitly acceptable (gfx.md
# Phase G7 phase-exit); the goal is C-level type-checking of the engine
# sources against the active backend.  Used by `make build-00cpc-compile-test`.
#
# The gfx_sp1.c backend body self-#ifdef out under jsp (it compiles to an
# empty translation unit), so only gfx_jsp.c carries a body — exactly one
# gfx backend is active, matching the ZX selection model.
#
# B6-1/B6-2 (step 5): the bank-switch primitive 00bswitch.c now has its CPC
# arm (memory_switch_bank() via a direct Gate-Array RAMR write), so the WHOLE
# engine — 00bswitch.c included — type-checks under +cpc with banking active.
ENGINE_COMPILE_TEST_CSRC	= $(wildcard $(ENGINE_DIR)/src/*.c) \
				  $(wildcard $(GENERATED_DIR)/*.c) \
				  $(wildcard $(GAME_SRC_DIR)/*.c)
ENGINE_COMPILE_TEST_OBJS	= $(ENGINE_COMPILE_TEST_CSRC:.c=.o)

# NOTE: section-check-cpc / final-cpc carry the '-cpc' suffix so they do NOT
# override the same-named targets already defined in Makefile.common (which is
# -included above). Reusing the bare names produced 7x "overriding recipe for
# target" GNU Make warnings on every build.
.PHONY: build main loader asmloader cpc dsk cdt final-cpc section-check-cpc compile-test \
	banking-build datasets codesets banked_code_empty banks bank_scaffold game_image \
	banked_loader bank_files banked_dsk cas-buffer-check org-crosscheck

ifeq ($(CPC_BANKED_BANKING),1)
# B7 step 9.2c/9.3: REAL banking build (set by top-level build-cpc-banked-test).
build: banking-build
else
# Phase T3a no-banking build (cpc-hello-banked etc.): single-step CPC programme.
build:
	$(MYMAKE) loader
	$(MYMAKE) asmloader
	$(MYMAKE) dsk
	$(MYMAKE) cpc
	$(MYMAKE) cdt
	$(MYMAKE) section-check-cpc
	echo "Build completed SUCCESSFULLY (cpc-banked)"
endif

################################################################################
##
## B7 step 9.2c/9.3 — cpc-banked REAL banking pipeline
##
## Engine RESIDENT (CPC_LINK_ENGINE_FULL=1, like minimal_cpc) + datasets and the
## user codeset compiled to expansion banks (banktool -p cpc-banked).  Produces a
## multi-file cold-boot disc: a standalone AMSDOS-headered LOADER.BIN (RUN"-able)
## that firmware-loads the headerless full-engine GAME.BIN to the engine ORG plus
## the per-bank BANK<n>.BIN files, then jp's the engine.  No banked ENGINE code
## yet (bank 4 reserved/empty; DC3-A offload is a later increment).  DSK packaged
## with appmake +cpmdisk -f cpcsystem (appmake +fat is MSX-only; +cpc --disk emits
## a malformed stub — see cpc-banked-disk-loader.md / cpc-banked-bringup.md).
##
################################################################################

# headerless engine image / AMSDOS loader / disc
GAME_IMAGE		= GAME.BIN
LOADER_BIN_CPC		= LOADER.BIN
BANKED_DSK		= $(CPC_NAME).dsk
APPMAKE_CPMDISK		= z88dk-appmake +cpmdisk

# loader org / engine entry — single-sourced from etc/rage1-config.yml
# banking.cpc-banked.loader (DC6, the same block loadertool reads).
LOADER_ORG_CPC		= $(shell awk '/^    loader:/{f=1} f&&/loader_org:/{print $$2; exit}' etc/rage1-config.yml)
MAIN_CODE_START_CPC	= $(shell awk '/^    loader:/{f=1} f&&/main_code_start:/{print $$2; exit}' etc/rage1-config.yml)

banking-build:
	# remove stale repo-root artifacts: these targets have no prerequisites, so
	# make would skip rebuilding them if a previous build left them in place
	# (top-level `make clean` only clears build/).  Includes the per-bank section
	# binaries zcc emits ($(CPC_NAME)_BANK_*.bin) and the AMSDOS bank files
	# (*.b[0-7]) so a stale bank cannot leak into the disc.
	rm -f $(GAME_IMAGE) main.map $(CPC_NAME) $(CPC_NAME).* $(CPC_NAME)_BANK_*.bin *.b[0-7] $(GENERATED_DIR)/bank_scaffold.asm
	$(MYMAKE) datasets
	$(MYMAKE) codesets
	$(MYMAKE) banked_code_empty
	$(MYMAKE) banks
	$(MYMAKE) bank_scaffold
	$(MYMAKE) game_image
	$(MYMAKE) section-check-cpc
	echo "Build completed SUCCESSFULLY (cpc-banked, banking)"

##
## Datasets: compile each dataset_N.src to a standalone binary org'ed at
## BANKED_DATASET_BASE_ADDRESS (0x8000, set by datagen), then ZX0-compress.
## banktool consumes the .zx0 files; the cold-boot loader streams them verbatim
## (compressed) into a bank, and dataset_activate() dzx0-decompresses to 0x8000.
##
datasets: $(ZX0_DATASETS)

dataset_%.bin:
	echo "Compiling cpc-banked DATASET $@ ..."
	# asm files MUST precede C files
	$(ZCC) $(ZCC_TARGET) $(CFLAGS) $(CFLAGS_LIST) --no-crt -o $@ $(GENERATED_DIR_DATASETS)/$(shell basename $@ .bin).src/*.{asm,c}
	echo "-- $$( basename $@ ) uncompressed: $$( stat -c%s $@ ) bytes (max $(DATASET_MAXSIZE))"
	if [ $$( stat -c%s $@ ) -gt $(DATASET_MAXSIZE) ]; then \
		echo "** ERROR: $$( basename $@ ) ($$( stat -c%s $@ )b) > DATASET_MAXSIZE ($(DATASET_MAXSIZE)b)"; exit 1; fi

dataset_%.zx0: dataset_%.bin
	echo "Compressing cpc-banked DATASET $< ..."
	$(ZX0) $< $@ >/dev/null 2>&1
	echo "-- $$( basename $@ ) compressed: $$( stat -c%s $@ ) bytes"

##
## Codesets: compile each codeset_N.src to a standalone binary org'ed at
## CODESET_ASSETS_BASE (0x4000, set by datagen).  Stored uncompressed in a bank;
## codeset_call_function() pages the bank into the 0x4000 window and calls in.
##
codesets: $(BIN_CODESETS)

codeset_%.bin:
	echo "Compiling cpc-banked CODESET $@ ..."
	$(ZCC) $(ZCC_TARGET) $(CFLAGS) $(CFLAGS_LIST) -I$(GAME_SRC_DIR) --no-crt -o $@ $(GENERATED_DIR_CODESETS)/$(shell basename $@ .bin).src/*.{asm,c}
	mv $(GENERATED_DIR_CODESETS)/$(shell basename $@ .bin)_code_compiler.bin $@
	if [ $$( stat -c%s $@ ) -gt $(CODESET_MAXSIZE) ]; then echo "** ERROR: $$( basename $@ ) > $(CODESET_MAXSIZE)b"; exit 1; fi

##
## No banked ENGINE code yet (option 2: engine resident).  banktool still expects
## engine/banked_code/banked_code.bin to exist and reserves bank 4 for it; an
## EMPTY file makes bank 4 reserved-but-zero-size (no BANK4.BIN emitted).
##
banked_code_empty:
	echo "cpc-banked: engine code RESIDENT (bank 4 reserved/empty) — empty banked_code.bin"
	: > engine/banked_code/banked_code.bin

##
## Banks: banktool -p cpc-banked lays datasets (.zx0) + codesets (.bin) into the
## per-platform bank set {4,5,6,7} (bank 4 reserved) and writes bank_<n>.bin +
## the dataset/codeset bank maps into build/generated/.
##
banks:
	echo "Building cpc-banked bank binaries + dataset/codeset maps..."
	./tools/banktool.pl -p cpc-banked -i $(GENERATED_DIR_DATASETS) -c $(GENERATED_DIR_CODESETS) -o $(GENERATED_DIR)

##
## z88dk bank scaffold (B7 step 10 redesign): for each populated bank_<n>.bin,
## emit `SECTION BANK_<n>` + `BINARY "bank_<n>.bin"` into bank_scaffold.asm.
## Linked into GAME (it lands in $(GENERATED_DIR), matched by the engine link's
## $(GENERATED_DIR)/*.asm wildcard).  The linker splits each BANK_<n> section
## into its own binary (org'ed in expansion RAM by mmap-cpc-banked.inc), and
## appmake +cpc --disk emits one AMSDOS bank disc file (GAME.B<n>) per populated
## bank + patches __crt_loader_filename so z88dk loadbanks streams them at boot.
##
bank_scaffold:
	echo "Generating cpc-banked z88dk bank scaffold (bankscaffoldtool)..."
	./tools/bankscaffoldtool.pl -p cpc-banked -i $(GENERATED_DIR) -o $(GENERATED_DIR)

##
## Full-engine image + bootable disc (B7 step 10 z88dk-banking redesign).
## The single-step -create-app -subtype=dsk link is now the WHOLE banking
## packaging: $(CPC_SRC) includes the generated bank_scaffold.asm (picked up by
## the $(GENERATED_DIR)/*.asm wildcard), so the linker splits each populated
## BANK_<n> section into its own binary and appmake +cpc --disk writes the
## bootable $(CPC_NAME).dsk containing the AMSDOS-headered main image (RUN-able
## as GAME) PLUS one bank file (GAME.B<n>) per populated bank, and patches
## __crt_loader_filename so the crt0's loadbanks streams them at boot.  No
## separate LOADER.BIN / hand-rolled multi-file disc anymore — this .dsk is the
## final artifact.  $(GAME_IMAGE) is a copy of the raw linked binary kept for
## reference/inspection; the .map drives section-check.
##
game_image: $(GAME_IMAGE)

$(GAME_IMAGE): $(CPC_SRC)
	echo "Linking full-engine image + bootable banked disc (org $(CRT_ORG_CODE), loadbanks crt0)..."
	$(STAGE_MMAP); \
	$(ZCC) $(ZCC_TARGET) $(CFLAGS) $(CFLAGS_LIST) -crt0=$(CPC_CRT0) -create-app -subtype=dsk -o $(CPC_NAME) $(CPC_SRC)
	cp $(CPC_NAME) $(GAME_IMAGE)
	cp $(CPC_NAME).map main.map

################################################################################
## LEGACY hand-rolled cold-boot LOADER pipeline (B7 step 9 / early step 10).
## RETAINED-BUT-UNWIRED as of the B7 step 10 z88dk-banking redesign: the targets
## below (bank_files / banked_loader / banked_dsk / org-crosscheck /
## cas-buffer-check) and the CPC_LOADER_CRT0 / crt0-cpc-banked-loader.asm +
## engine/loader-cpc-banked/*.in templates are NO LONGER invoked by
## banking-build (z88dk loadbanks + appmake --disk own bank loading now), but are
## kept on disk + invokable for easy revert / comparison.  See the step-10
## redesign notes in .prompts/2026-06-11.md and cpc-banked-bringup.md.
################################################################################

##
## Per-bank BANK<n>.BIN (headerless, raw, from banktool's bank_<n>.bin).
##
bank_files:
	echo "Materialising per-bank BANK<n>.BIN files..."
	rm -f BANK*.BIN
	for b in $(GENERATED_DIR)/bank_*.bin; do \
		[ -e "$$b" ] || continue; \
		n=$$( basename $$b .bin | sed 's/^bank_//' ); \
		cp $$b BANK$$n.BIN ; \
		echo "  BANK$$n.BIN ($$( stat -c%s $$b ) bytes)"; \
	done

##
## Cold-boot LOADER.BIN: loadertool emits the per-bank streaming asmloader (it
## reads the bank_<n>.bin set), we assemble it to a raw binary at LOADER_ORG,
## then wrap it with an AMSDOS header (load+entry = LOADER_ORG) so RUN"LOADER
## boots it.
##
# The loader is a +cpc CRT program (NOT --no-crt) so it can reach the AMSDOS
# firmware CAS routines through z88dk's `firmware` interposer (routes CAS_IN to
# disc, not tape).  Its own CRT config (origin in page C @ LOADER_ORG_CPC, firmware
# ISR kept alive) is in zpragma-cpc-banked-loader.inc — distinct from the engine's
# zpragma.  Built with a minimal flag set (no JSP/engine includes needed).
ZPRAGMA_LOADER_INC	= zpragma-cpc-banked-loader.inc
LOADER_CFLAGS		= -vn -SO2 --opt-code-size -compiler=sdcc --max-allocs-per-node200000 -pragma-include $(ZPRAGMA_LOADER_INC)

banked_loader: $(LOADER_BIN_CPC)

$(LOADER_BIN_CPC):
	echo "Generating cpc-banked cold-boot loader (loadertool)..."
	./tools/loadertool.pl --platform=cpc-banked -i $(GENERATED_DIR) -o $(GENERATED_DIR_ASMLOADER)
	echo "Building loader as a +cpc CRT program (org $(LOADER_ORG_CPC), pristine-fw custom crt0, direct CAS)..."
	$(ZCC) $(ZCC_TARGET) $(LOADER_CFLAGS) $(CFLAGS_LIST) -crt0=$(CPC_LOADER_CRT0) -o loader_cpc $(ASMLOADER_SRC)
	echo "Wrapping loader -> AMSDOS LOADER.BIN (RUN\"LOADER, load+entry $(LOADER_ORG_CPC))..."
	$(APPMAKE) --org $(LOADER_ORG_CPC) -b loader_cpc -o $(LOADER_BIN_CPC)

##
## Multi-file bootable disc: appmake +cpmdisk -f cpcsystem.  -b = the bootable
## AMSDOS LOADER.BIN; --add-file = the headerless GAME.BIN + each BANK<n>.BIN.
##
# PHONY (not a game.dsk file target) so it never collides with the no-banking
# $(DSK_FILE) recipe.  The BANK*.BIN list is globbed at RECIPE time (a parse-time
# $(wildcard) would be empty on a clean build, before bank_files runs).
banked_dsk:
	echo "Packaging cold-boot disc $(BANKED_DSK) (+cpmdisk cpcsystem)..."
	addbanks=""; for bf in BANK*.BIN; do [ -e "$$bf" ] && addbanks="$$addbanks --add-file $$bf"; done; \
	$(APPMAKE_CPMDISK) -f cpcsystem --container dsk -b $(LOADER_BIN_CPC) \
		--add-file $(GAME_IMAGE) $$addbanks -o $(BANKED_DSK)
	echo "  $(BANKED_DSK): $$( stat -c%s $(BANKED_DSK) ) bytes; files:"
	for f in $(LOADER_BIN_CPC) $(GAME_IMAGE) BANK*.BIN; do echo "    $$f"; done

##
## 9.2b NIT2 cross-check: the loader's engine-entry (main_code_start, from YAML)
## MUST equal the engine CRT_ORG_CODE, or the loader jp's to the wrong address.
##
org-crosscheck:
	if [ "$(MAIN_CODE_START_CPC)" != "$(CRT_ORG_CODE)" ]; then \
		echo "** ERROR: loader main_code_start ($(MAIN_CODE_START_CPC)) != CRT_ORG_CODE ($(CRT_ORG_CODE))"; exit 1; fi
	echo "  OK: loader main_code_start == CRT_ORG_CODE ($(CRT_ORG_CODE))"

##
## CAS-buffer invariant (design note §8.5): the cold-boot loader reuses a 2 KB
## firmware CAS input buffer at 0x8000-0x87FF while streaming the banks AFTER
## GAME.BIN is in place, so the GAME.BIN image (loaded at CRT_ORG_CODE) must not
## extend into 0x8000.  Check the linked image top-of-code from main.map.
##
cas-buffer-check:
	echo "CAS-buffer invariant: GAME.BIN image must end below 0x8000..."
	img_end=$$(( $$(printf '%d' $(CRT_ORG_CODE)) + $$( stat -c%s $(GAME_IMAGE) ) )); \
	if [ $$img_end -gt $$(( 0x8000 )) ]; then \
		echo "** ERROR: GAME.BIN ends at $$( printf '0x%04X' $$img_end ) — past the 0x8000 CAS buffer"; exit 1; fi; \
	echo "  OK: GAME.BIN ends at $$( printf '0x%04X' $$img_end ) (< 0x8000)"

# G7-4: compile-only engine type-check (no link).  Compiles every engine/src/*.c
# (plus generated + game_src) to .o under +cpc with the live JSP backend.
# Exits 0 if all sources type-check; linkage is intentionally NOT attempted.
compile-test: $(ENGINE_COMPILE_TEST_OBJS)
	echo "Engine compile-test (cpc-banked / JSP backend) SUCCESSFUL — all engine/src/*.c type-checked under +cpc with BUILD_FEATURE_PLATFORM_CPC_BANKED (no link)."

##
## CPC artifacts — built single-step with `zcc -create-app`.
##
## We do NOT pre-link a separate main.bin and then run `appmake --disk`:
## that two-step path emits a ~2.7 KB malformed DSK stub. The integrated
## `zcc -create-app -subtype=dsk` driver links AND packages in one pass,
## producing a valid bootable Extended-CPC-DSK (~194 KB). It also writes
## a main.map alongside the binary, consumed by section-check.
##
## zcc -create-app -subtype=dsk -> $(DSK_FILE) (disc image, Caprice32-loadable)
## appmake +cpc -b $(CPC_NAME)    -> $(CPC_FILE) (raw AMSDOS .cpc image)
##

# Source list passed to zcc in one shot (CSRC/ASMSRC overridden above to
# exclude the ZX-specific engine/src/*).
CPC_SRC			= $(CSRC) $(ASMSRC)

dsk: $(DSK_FILE)

# Single-step build+link+package. zcc writes the linked binary as
# $(CPC_NAME) (no extension) plus $(CPC_NAME).dsk and a $(CPC_NAME).map.
$(DSK_FILE): $(CPC_SRC)
	echo "Building + packaging $(DSK_FILE) (cpc-banked disc image)..."
	$(STAGE_MMAP); \
	$(ZCC) $(ZCC_TARGET) $(CFLAGS) $(CFLAGS_LIST) \
		-create-app -subtype=dsk -o $(CPC_NAME) $(CPC_SRC)
	cp $(CPC_NAME) $(MAIN_BIN)
	cp $(CPC_NAME).map main.map

# The raw .cpc AMSDOS image is built from the already-linked $(CPC_NAME)
# binary via appmake (no --disk). Depends on the .dsk step having produced
# the linked binary.
cpc: $(CPC_FILE)

$(CPC_FILE): $(DSK_FILE)
	echo "Packaging $(CPC_FILE) (cpc-banked AMSDOS image)..."
	$(APPMAKE) --org $(CRT_ORG_CODE) -b $(CPC_NAME) -o $(CPC_FILE)

main: $(DSK_FILE)

##
## ASM loader (T2-4/T2-5): loadertool.pl emits asmloader.asm from the
## engine/loader-cpc-flat/ template; we then assemble it with zcc +cpc.
## On cpc-flat this is a trivial stub (no banks/SUBs); it is emitted for
## toolchain symmetry and as a hook for the future pre-main boot sequence.
##

loader:
	echo "Creating CPC loader stub..."
	# T3a: trivial cpc-flat stub loader (NOT in the .dsk boot path — the .dsk is
	# built by zcc -create-app). The real bank-aware cpc-banked asmloader is
	# Phase B7/T3-6 (loadertool --platform=cpc-banked).
	./tools/loadertool.pl --platform=cpc-flat -i $(GENERATED_DIR) -o $(GENERATED_DIR_ASMLOADER)

asmloader: $(ASMLOADER_BIN)

$(ASMLOADER_BIN):
	echo "Assembling CPC loader stub..."
	$(ZCC) $(ZCC_TARGET) $(CFLAGS) $(CFLAGS_LIST) --no-crt $(ASMLOADER_SRC) -o $(ASMLOADER_BIN)

# .cdt (tape image) via 2cdt (T2-8/T2-9)
cdt: $(CDT_FILE)

$(CDT_FILE): $(CPC_FILE)
	echo "Packaging $(CDT_FILE) (cpc-banked)..."
	if command -v 2cdt >/dev/null 2>&1; then \
		2cdt -n GAME -X $(CRT_ORG_CODE) -L $(CRT_ORG_CODE) $(CPC_FILE) $(CDT_FILE) 2>/dev/null \
		  || 2cdt -n GAME $(CPC_FILE) $(CDT_FILE); \
	else \
		echo "  [skip] 2cdt not found — $(CDT_FILE) not generated (install via docker/Dockerfile T2-9)"; \
	fi

# The 'final-cpc' target is a no-op alias for the CPC build shape (the ZX
# 'final: $(FINAL_TAP)' in Makefile.common does not apply on cpc-flat).
# On CPC-flat the 'dsk' step is the equivalent of 'final'. Suffixed with
# '-cpc' to avoid overriding Makefile.common's 'final:' target.
final-cpc: dsk

##
## section-check-cpc: validate that all sections land inside expected regions
## (T2-3).  At Phase T3a, the +cpc CRT uses its own built-in section
## layout (__MMAP is NOT -1 — see zpragma-cpc-banked.inc comments).
## The full section-check is deferred to Phase B5/B6 when the custom mmap
## hook is implemented.  We do a minimal sanity check instead: verify
## that the .map file was produced and that no sections landed in the
## screen RAM region (0xC000-0xFFFF).  Suffixed with '-cpc' to avoid
## overriding Makefile.common's 'section-check:' target.
##

section-check-cpc:
	echo "Section check (cpc-banked, Phase T3a minimal)..."
	if [ ! -f main.map ]; then echo "  ERROR: main.map not produced"; exit 1; fi
	if grep -E '^\s*[0-9A-Fa-f]{4}\s' main.map | awk '{print $$1}' | grep -qiE '^[Cc][0-9A-Fa-f]{3}'; then \
		echo "  ERROR: section(s) in screen RAM region (0xC000-0xFFFF)!"; exit 1; \
	fi
	echo "  OK: no sections in screen RAM region."
	## The RAGE1-owned IM1 ISR (rage1_cpc_isr) and the 50 Hz body it calls run while a
	## dataset bank may be paged into 0x4000-0x7FFF, so the WHOLE IRQ path MUST link
	## below 0x4000 (page A, always mapped).  The ISR + state are pinned there by the
	## custom mmap (code_crt_common); the C body + callees land in code_compiler by link
	## order, so assert their addresses here (see doc/multiplatform-plan/cpc-interrupts.md).
	## Only full-engine / ISR-linking builds carry these symbols; the no-banking smoke
	## games (cpc-hello-banked, cpc-bswitch-test) do not link the ISR, so a symbol ABSENT
	## from the map is skipped (a real engine build that linked the ISR always has it —
	## init_interrupts() references it, so an absent symbol would fail the LINK first).
	checked= ; \
	for sym in _rage1_cpc_isr _rage1_50hz_tick _do_timer_tick _do_periodic_isr_tasks ; do \
		addr=$$(grep -E "^$$sym[[:space:]]" main.map | head -1 | sed -E 's/^[^=]*= \$$([0-9A-Fa-f]+).*/\1/') ; \
		if [ -z "$$addr" ]; then continue ; fi ; \
		checked=1 ; \
		if [ $$((16#$$addr)) -ge 16384 ]; then \
			echo "  ERROR: $$sym at 0x$$addr is >= 0x4000 - the IM1 ISR path must stay below the 0x4000 bank-swap window!"; exit 1 ; \
		fi ; \
	done ; \
	if [ -n "$$checked" ]; then \
		echo "  OK: IM1 ISR + 50 Hz-body path links below 0x4000." ; \
	else \
		echo "  OK: no RAGE1 IM1 ISR linked (no-engine smoke build) - ISR-placement check skipped." ; \
	fi

##
## CRT_ORG_CODE exposed for appmake — sourced from rage1-config.yml via yq
## (MM_CRT_ORG_CODE), same value injected into the engine link via -pragma-define.
##

CRT_ORG_CODE		= $(MM_CRT_ORG_CODE)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; This file has been generated automatically, do not edit!
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; RAGE1 cpc-banked (CPC 6128) cold-boot ASM loader (LOADER.BIN).
;;
;; Packaging model 2 (design note §8.5): a SEPARATE AMSDOS binary, the
;; RUN"LOADER target.  It is a normal +cpc CRT program (this `_main` is the
;; CRT entry), built at CRT_ORG_CODE from zpragma-cpc-banked-loader.inc (page C,
;; ~0x8800) — an ALWAYS-MAPPED page that survives bank streaming (page B is paged
;; out when GA Config 4-7 is selected; page A holds the engine image).
;;
;; CRITICAL — firmware calling convention: this loader is built with a CUSTOM
;; crt0 (crt0-cpc-banked-loader.asm) that does NOT seize the firmware exx/ISR
;; state — i.e. it omits the stock crt0's `call cpc_enable_process_exx_set`.  So
;; _main runs in PRISTINE firmware state (fw alt-register set + fw ISR at 0x0039
;; intact), and the AMSDOS CAS routines are called DIRECTLY (call 0xBCxx).  This
;; mirrors z88dk's loadbanks, which loads many files in pristine state at crt0.
;; Do NOT use the `firmware` interposer here: it calls cpc_enable_fw_exx_set /
;; cpc_enable_process_exx_set around every call, re-seizing the firmware state —
;; which leaves ONLY THE FIRST disc transaction reliable (a 2nd CAS_IN_OPEN, or a
;; large CAS_IN_DIRECT as a non-first op, hard-crashes; bisected 2026-06-11).
;; (The old "direct call routes CAS to TAPE" note held only in PROCESS exx state;
;; in pristine/native state the direct call hits disc.)  The loader hands over to
;; the engine still in pristine state — exactly what the engine's own
;; crt0-cpc-banked.asm expects (its cpc_enable_process_exx_set captures the fw
;; exx set + fw ISR at entry).
;;
;; It firmware-loads, then hands over to the engine:
;;   1. the resident engine image GAME.BIN (headerless raw) -> engine ORG, and
;;   2. each populated expansion-RAM bank BANK<n>.BIN -> its physical RAM bank,
;;      VERBATIM into the 0x4000 swap window (banks stay ZX0-compressed; there is
;;      NO decompress-at-load), via select GA Config N / CAS IN DIRECT / restore
;;      GA Config 0.
;;   3. jp the engine entry.
;; (CAS IN DIRECT reads a whole file to EOF, so no file size is carried.)
;;
;; Interrupts stay ENABLED throughout (firmware 300 Hz tick drives disc motor /
;; timeouts); firmware-disable is the engine's init_interrupts() job, not the
;; loader's (design decision Q4).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

    SECTION code_compiler
    PUBLIC _main

    ;; AMSDOS firmware input jumpblock (|DISC is the 6128-with-drive default)
    defc CAS_IN_OPEN   = 0xBC77    ;; B=name len, HL=name addr, DE=2K buffer addr
    defc CAS_IN_DIRECT = 0xBC83    ;; HL=load address; loads the whole open file
    defc CAS_IN_CLOSE  = 0xBC7A

_main:
    ;; Entered in PRISTINE firmware state by crt0-cpc-banked-loader.asm (no
    ;; process-exx seize).  Interrupts are ON (fw 300 Hz tick drives the disc
    ;; motor); SP is set; ROMs are walked.  All CAS calls below are DIRECT.

    ;; ---- load the resident engine image GAME.BIN -> @@MAIN_CODE_START@@ ----
    ;; (Config 0 / base map.)  DIRECT CAS calls in pristine fw state.
    ld   b, @@MAIN_FILE_LEN@@        ;; filename length
    ld   hl, _mainname              ;; filename "@@MAIN_FILE@@"
    ld   de, 0x8000                 ;; 2K firmware CAS buffer (page C, just below
                                    ;; this loader's 0x8800 origin; free pre-game)
    call CAS_IN_OPEN
    jp   nc, _loader_error
    ld   hl, @@MAIN_CODE_START@@    ;; destination = engine ORG (headerless raw image)
    call CAS_IN_DIRECT
    push af                         ;; preserve the load result across CAS IN CLOSE
    call CAS_IN_CLOSE
    pop  af
    jp   nc, _loader_error
    jr   _maindone
_mainname:
    defm "@@MAIN_FILE@@"
_maindone:

@@BANK_LOAD_BLOCK@@    ;; engine image + all banks loaded; GA is back in Config 0.
    ;; Hand over to the resident engine entry.  GAME.BIN uses a custom minimal
    ;; crt0 (crt0-cpc-banked.asm, B7 step 9.5) that is self-contained at entry:
    ;; it runs NO firmware-dependent startup, so this loader does NOT need to
    ;; restore firmware-native exx/ISR state before the jp.  It just hands over
    ;; the state it already established (ROMs disabled by this loader's own CRT
    ;; mc_start_program; firmware still live for the 300 Hz disc tick until the
    ;; engine's init_interrupts() takes over the IM1 ISR).
    jp @@MAIN_CODE_START@@

    ;; A firmware file op failed (disc error / missing file).  With a correctly
    ;; packaged disc this is unreachable; hang with the firmware still alive so
    ;; the failure is observable rather than silently running the engine against
    ;; a half-loaded image.
_loader_error:
    jr _loader_error

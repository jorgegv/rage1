;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; This file has been generated automatically, do not edit!
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; RAGE1 cpc-banked (CPC 6128) cold-boot ASM loader.
;;
;; Streams each populated expansion-RAM bank from disc into its physical
;; RAM bank via the AMSDOS firmware, then hands control to the resident
;; engine.  See doc/multiplatform-plan/cpc-banked-disk-loader.md (§3 load
;; sequence, §4 firmware mechanism, §6 PoC findings).
;;
;; Per-bank sequence (one BANK<n>.BIN file per populated bank, Option A):
;;   CAS IN OPEN -> select GA Config N -> CAS IN DIRECT the file VERBATIM
;;   into the 0x4000 swap window (banks stay ZX0-compressed; there is NO
;;   decompress-at-load) -> restore GA Config 0 -> CAS IN CLOSE.
;;
;; Firmware calling convention: this loader runs at COLD BOOT in NATIVE
;; firmware state (pure ASM, before the z88dk +cpc CRT seizes the firmware
;; alternate-register set / 0x0038 ISR), so the firmware jumpblock entries
;; are reached by a DIRECT `call` — the z88dk `firmware` interposer the
;; step-8a PoC needed (post-CRT) is NOT required here (design note §6).
;;
;; Interrupts stay ENABLED throughout: the AMSDOS disc routines rely on the
;; firmware 300 Hz tick (motor spin-up / timeouts), so the loader does NOT
;; `di` (the step-8a PoC ran the firmware loads with interrupts enabled;
;; matches design decision Q4 — firmware-disable is owned by the engine's
;; init_interrupts(), not the loader).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

    org @@LOADER_ORG@@

    ;; AMSDOS firmware input jumpblock (|DISC is the 6128-with-drive default)
    defc CAS_IN_OPEN   = 0xBC77    ;; B=name len, HL=name addr, DE=2K buffer addr
    defc CAS_IN_DIRECT = 0xBC83    ;; HL=load address; loads the whole open file
    defc CAS_IN_CLOSE  = 0xBC7A

@@BANK_LOAD_BLOCK@@    ;; all banks streamed; the GA is back in Config 0 (base map).
    ;; Hand over to the resident engine entry.  Firmware is still live;
    ;; the engine's init_interrupts() disables it and installs the IM1 ISR.
    jp @@MAIN_CODE_START@@

    ;; A firmware file op failed (disc error / missing bank file).  With a
    ;; correctly packaged disc this is unreachable; hang with the firmware
    ;; still alive so the failure is observable rather than silently running
    ;; the engine against half-loaded banks.
_loader_error:
    jr _loader_error
